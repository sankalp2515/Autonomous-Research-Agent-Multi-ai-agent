# Veriscope — backend configuration template.
# Copy to `.env` (cd backend && cp .env.example .env) and fill in the marked
# values. Everything here has a safe local default EXCEPT one LLM key, which
# you must provide (free tiers work). Never commit your real .env.

# ── Runtime ──────────────────────────────────────────────────────────────
APP_ENV=dev                 # dev | staging | prod  (prod refuses AUTH_DISABLED=true)
LOG_LEVEL=INFO
LOG_FORMAT=console          # console (readable) | json (production)

# ── Auth ─────────────────────────────────────────────────────────────────
# Local dev: leave auth OFF so you can use the app immediately (no signup).
# Production: set false and configure the SUPABASE_* values below.
AUTH_DISABLED=true
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key   # frontend sign-in (not a secret)
# SUPABASE_JWT_SECRET=                            # only for legacy HS256 tokens

# ── Datastores (defaults match `docker compose up`) ──────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/research
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6333

# ── LLM providers — YOU NEED AT LEAST ONE (free tiers are fine) ──────────
# Groq (fast, generous free tier):   https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (free tier):         https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra providers (auto-used if funded):
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# ── External sources (optional — improve coverage) ───────────────────────
# GITHUB_TOKEN=                       # https://github.com/settings/tokens (public_repo scope)
# SEMANTIC_SCHOLAR_API_KEY=           # https://www.semanticscholar.org/product/api
# TAVILY_API_KEY=                     # https://tavily.com  (blog/web search)

# ── Local ML (embeddings + NLI verification gate) ────────────────────────
# On: full verification (needs the [ml] extra ~2GB). Off: BM25 + quote-match
# only (fast, no torch) — the gate still blocks fabricated quotes.
ML_EMBEDDINGS_ENABLED=true
ML_RERANK_ENABLED=true
ML_NLI_ENABLED=true

# ── Optional: observability & scale (see docker-compose observability profile) ──
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_TOKEN=
# BLOB_BACKEND=local                  # local | s3  (s3 for multi-node; needs the [s3] extra)
