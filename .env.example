# ── Runtime ──────────────────────────────────────────────────────────────
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | console

# ── System of record (Supabase Postgres or local Postgres) ──────────────
# Supabase: use the connection string from Project Settings -> Database.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/research

# ── Auth (Supabase JWT). AUTH_DISABLED=true for local dev. ──────────────
AUTH_DISABLED=false
SUPABASE_JWT_SECRET=sb_publishable_ZDmFy7cBE1Vy79wicmOC4w_d0kvOizj
SUPABASE_URL="https://dzdcalrssygtejfawyuk.supabase.co"

# ── Stores ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# ── Free-tier LLM providers ──────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#wanjarisankalp account used for huggingface api key
HUGGINGFACE_API_KEY=
#samertrib
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-content-safety:free
#samertrib
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Requests-per-minute budgets honored by the token-bucket throttle.
GEMINI_RPM=10
GROQ_RPM=25

# ── External research sources ────────────────────────────────────────────
TAVILY_API_KEY=
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=

# ── Local ML (set false to run without torch installed) ─────────────────
ML_EMBEDDINGS_ENABLED=true
ML_RERANK_ENABLED=true
ML_NLI_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# ── Pipeline budgets ─────────────────────────────────────────────────────
RUN_MAX_LLM_CALLS=60
RUN_MAX_WALL_SECONDS=1800
SECTION_MAX_REGENS=2
SUBQUESTION_MAX_REPLANS=1
