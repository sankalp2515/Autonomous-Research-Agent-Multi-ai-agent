    "e2e": "npm run build:e2e && playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
