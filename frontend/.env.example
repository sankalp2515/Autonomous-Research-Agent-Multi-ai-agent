# Copy to .env and fill in. All VITE_* vars are inlined into the client bundle
# at build time and are therefore PUBLIC — never put secrets here.

# Supabase auth (optional). If both are omitted the app runs open (local dev)
# with no sign-in. When set, users authenticate and every API call carries the
# access token. The ANON key is a publishable key and is safe to ship.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Error telemetry (optional). Set to a Sentry DSN to turn on crash reporting.
# Leave blank to disable — the app makes zero telemetry calls without it.
VITE_SENTRY_DSN=

# Shown in crash reports so you can tie an error to a build. Optional.
VITE_RELEASE=veriscope@dev
